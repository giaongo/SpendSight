# Copy to terraform.tfvars (gitignored) and fill in.
# Verda credentials are NOT set here: export VERDA_CLIENT_ID and VERDA_CLIENT_SECRET.

team_ssh_keys = {
  # name = "contents of ~/.ssh/id_ed25519.pub"
  alice = "ssh-ed25519 AAAAC3Nza... alice@laptop"
}

# Your public IPs (curl -4 ifconfig.me), as /32.
team_cidrs = ["203.0.113.7/32"]

# Leave false until OPS-05 says the dataset may be public.
web_open_to_all = false

# Defaults, from the Verda API. Changing any of these replaces the VM.
# location        = "FIN-03"
# instance_type   = "CPU-TURIN.4V.16G"
# image           = "ubuntu-24.04"
# os_disk_size_gb = 100
