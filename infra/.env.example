# Copy to infra/.env on the instance (gitignored). Not for secrets:
# those go in /data/.env, which the api service loads.

# Public name Caddy serves and gets a certificate for.
# sslip.io form: dashes in the IP from `terraform output public_ip`.
SPENDSIGHT_HOST=api.203-0-113-7.sslip.io

# Where the data lives on the host. Default /data; override for a local test.
# DATA_DIR=/data
